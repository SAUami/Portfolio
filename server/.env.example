# ==============================================================
# Saurabh Portfolio Backend - Environment Variables Configuration
# ==============================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Business Contact Settings
# Target inbox where incoming client enquiries will be routed
BUSINESS_EMAIL=saurabh.founder@example.com

# Database Configuration (Optional - MongoDB)
# Leave empty to run without database storage.
# If configured, enquiries will be validated and stored persistently.
MONGODB_URI=mongodb://localhost:27017/saurabh_portfolio

# Email Provider Configuration (SMTP)
# Works with Gmail App Password, Resend, SendGrid, Amazon SES, or Mailtrap.
# Leave empty or keep placeholder if email notifications are not yet activated.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Saurabh Web Studio" <notifications@example.com>

# Optional Third-Party CRM / Google Sheets Integration
# Disabled by default. To enable, provide your webhook URL and set to true.
ENABLE_CRM_ADAPTER=false
CRM_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
CRM_API_KEY=
